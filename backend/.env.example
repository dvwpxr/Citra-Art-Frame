# Salin file ini menjadi .env, lalu isi nilainya:
#   cp .env.example .env
#
# Jangan masukkan credential asli ke file ini. File .env sudah diabaikan Git.

# Database MySQL (wajib)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=citraframe
DB_USER=
DB_PASSWORD=

# Aplikasi dan autentikasi admin (wajib)
# Gunakan "production" saat aplikasi dijalankan di production.
APP_ENV=development
# Railway mengisi PORT secara otomatis. Nilai ini digunakan untuk local development.
PORT=8080
# Buat nilai acak yang panjang, misalnya: openssl rand -base64 48
JWT_SECRET=
ADMIN_USERNAME=
# Buat hash dari folder backend dengan: go run ./cmd/adminhash
# Tanda kutip tunggal diperlukan karena format hash mengandung karakter "$".
ADMIN_PASSWORD_HASH=''

# Firebase Authentication
FIREBASE_PROJECT_ID=

# Flip Payment Gateway
FLIP_SECRET_KEY=
FLIP_WEBHOOK_SECRET=
# Contoh: http://localhost:5173/invoice
FLIP_REDIRECT_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API.co.id (wilayah dan ongkir)
API_CO_ID_KEY=
API_CO_ID_BASE_URL=
STORE_ORIGIN_VILLAGE_CODE=
# Aktifkan hanya untuk demo/local ketika provider ongkir tidak tersedia.
SHIPPING_FALLBACK_ENABLED=false

# Pengujian integrasi (opsional; nonaktif secara default)
BAB4_INTEGRATION=0
BAB4_BLACKBOX=0
BAB4_BACKEND_URL=http://127.0.0.1:8080
BAB4_FRONTEND_URL=http://127.0.0.1:5173
BAB4_TEST_PREFIX=

# Pengaman migrasi. Ubah sementara ke 1 hanya untuk database lokal non-test.
ALLOW_NON_TEST_MIGRATION=0
