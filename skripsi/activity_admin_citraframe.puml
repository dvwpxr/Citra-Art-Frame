@startuml Activity_Admin_CitraFrame

title Activity Diagram Admin - Sistem CitraFrame

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFFDE7
  BorderColor #C09553
  ArrowColor #333333
}
skinparam partition {
  BackgroundColor #FAFAFA
  BorderColor #CCCCCC
}

|#FFF8F0|Admin|
|#FAFAFA|Sistem CitraFrame|
|#EEF7FF|Database|

|Admin|
start
:Mengakses Panel Admin (/login);
:Memasukkan Username & Password;

|Sistem CitraFrame|
:Memvalidasi Kredensial Admin;

if (Username & Password Valid?) then (Tidak / Gagal)
  :Menampilkan Pesan Error Login;
  |Admin|
  :Kembali ke Form Login;
  detach
else (Ya / Berhasil)
  |Sistem CitraFrame|
  :Generate JWT Token &\nSet HTTP-Only Cookie;
  :Mengarahkan ke Dashboard (/dashboard);
endif

|Database|
:Mengambil Rekapitulasi Statistik\n(Pesanan, Pendapatan, Produk Populer);

|Sistem CitraFrame|
:Menampilkan Grafik & Angka\nStatistik Dashboard;

|Admin|
fork
  :Memilih Menu Manajemen\nProduk Bingkai (/dashboard/product);
  if (Pilih Operasi Produk) then (Tambah Baru)
    :Input Nama, Harga, Spesifikasi,\n& Upload Gambar Bingkai;
    |Sistem CitraFrame|
    :Proses Upload & Validasi Data;
    |Database|
    :Menyimpan Produk Baru\nke Tabel products;
  else if (Edit Produk)
    |Admin|
    :Mengubah Harga / Spesifikasi Produk;
    |Database|
    :Memperbarui Data Produk;
  else (Hapus Produk)
    |Admin|
    :Konfirmasi Penghapusan Produk;
    |Database|
    :Menghapus Produk dari Database;
  endif
fork again
  |Admin|
  :Memilih Menu Manajemen\nArt Prints (/dashboard/prints);
  if (Pilih Operasi Art Print) then (Tambah Baru)
    :Input Judul, Seniman, Harga,\nStok, & Upload Artwork;
    |Database|
    :Menyimpan Art Print Baru\nke Tabel art_prints;
  else if (Edit Art Print / Stok)
    |Admin|
    :Mengubah Data & Kuantitas Stok;
    |Database|
    :Memperbarui Data Art Print;
  else (Hapus Art Print)
    |Admin|
    :Konfirmasi Penghapusan Art Print;
    |Database|
    :Menghapus Art Print dari Database;
  endif
fork again
  |Admin|
  :Memilih Menu Produk Populer\n(/dashboard/popular-frames);
  if (Pilih Tindakan) then (Set Populer)
    :Menandai Produk Sebagai Populer;
  else (Hapus Populer)
    :Menghapus Penanda Populer;
  endif
  |Database|
  :Memperbarui Status Populer Produk;
fork again
  |Admin|
  :Memilih Menu Slider Beranda\n(/dashboard/slider);
  if (Pilih Tindakan) then (Tambah Slider)
    :Upload Gambar Banner Promo;
    |Database|
    :Menyimpan Slider Baru;
  else (Hapus Slider)
    |Admin|
    :Konfirmasi Hapus Slider;
    |Database|
    :Menghapus Slider dari Database;
  endif
fork again
  |Admin|
  :Memilih Menu Manajemen\nPesanan (/dashboard/order);
  :Memfilter Status atau\nMencari Nomor Pesanan;
  |Database|
  :Mengambil Data Pesanan Sesuai Filter;
  |Sistem CitraFrame|
  :Menampilkan Daftar Pesanan Pelanggan;
  |Admin|
  :Melihat Detail Pesanan\n(Rincian Item, Alamat, Bukti Bayar);
  :Mengubah Status Pesanan\n(PENDING -> PROCESSING -> SHIPPED -> DELIVERED);
  |Database|
  :Memperbarui Status Pesanan\npada Tabel orders;
end merge

|Sistem CitraFrame|
:Menampilkan Notifikasi Sukses\nPerubahan Data kepada Admin;

|Admin|
if (Ingin Melakukan Kelola Data Lain?) then (Ya)
  :Kembali Memilih Menu Manajemen;
else (Tidak)
  :Menekan Tombol Logout;
  |Sistem CitraFrame|
  :Menghapus Cookie JWT\n(Clear-Site-Data);
  |Admin|
  :Kembali ke Halaman Login (/login);
endif

stop
@enduml
