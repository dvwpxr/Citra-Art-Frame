@startuml Flowchart_Admin_CitraFrame

title Flowchart Sistem Admin - CitraFrame

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F9F9F9
  BorderColor #555555
  ArrowColor #333333
  DiamondBackgroundColor #FFFDE7
  DiamondBorderColor #C09553
}

start
:Mulai Akses Panel Admin;

repeat
  :Membuka Halaman Login Admin (/login);
  :Input Username & Password Admin;
  :Validasi Kredensial Admin;
  if (Kredensial Valid?) then (Gagal)
    :Tampilkan Pesan Error Login;
  else (Berhasil)
  endif
repeat while (Kredensial Valid?) is (Gagal)

:Generate JWT Token & Set Cookie Autentikasi;
:Masuk ke Dashboard Admin (/dashboard);
:Mengambil & Menampilkan Statistik Dashboard\n(Total Pesanan, Pendapatan, Produk Populer);

repeat
  if (Pilih Menu Admin) then (Manajemen Produk Bingkai)
    :Buka Halaman Produk Bingkai (/dashboard/product);
    if (Pilih Operasi Produk?) then (Tambah Baru)
      :Input Nama, Harga, Spesifikasi,\n& Upload Gambar Bingkai;
      :Simpan Data Produk ke Database;
    else if (Edit Produk)
      :Ubah Informasi / Harga Produk;
      :Update Data Produk di Database;
    else (Hapus Produk)
      :Konfirmasi Penghapusan;
      :Hapus Produk dari Database;
    endif
  else if (Manajemen Produk Populer)
    :Buka Halaman Produk Populer (/dashboard/popular-frames);
    if (Pilih Tindakan?) then (Set Populer)
      :Tandai Produk Sebagai Populer;
    else (Hapus dari Populer)
      :Hapus Penanda Populer pada Produk;
    endif
    :Update Status Populer di Database;
  else if (Manajemen Art Prints)
    :Buka Halaman Art Prints (/dashboard/prints);
    if (Pilih Operasi Art Print?) then (Tambah Baru)
      :Input Judul, Seniman, Harga, Stok,\n& Upload Karya Seni;
      :Simpan Art Print ke Database;
    else if (Edit Art Print / Stok)
      :Ubah Data atau Kuantitas Stok;
      :Update Art Print di Database;
    else (Hapus Art Print)
      :Konfirmasi Penghapusan;
      :Hapus Art Print dari Database;
    endif
  else if (Manajemen Slider Beranda)
    :Buka Halaman Slider Promo (/dashboard/slider);
    if (Pilih Operasi Slider?) then (Tambah Slider)
      :Upload Gambar Banner & Input Judul/Link;
      :Simpan Slider ke Database;
    else (Hapus Slider)
      :Konfirmasi Penghapusan;
      :Hapus Slider dari Database;
    endif
  else (Manajemen Pesanan)
    :Buka Halaman Pesanan (/dashboard/order);
    :Melihat Daftar Semua Pesanan Pelanggan;
    if (Pilih Tindakan Pesanan?) then (Filter / Cari)
      :Input Kata Kunci atau Filter Status/Tanggal;
      :Tampilkan Daftar Pesanan Hasil Filter;
    else if (Lihat Detail Pesanan)
      :Pilih Pesanan Tertentu;
      :Tampilkan Rincian Item, Alamat Pengiriman,\n& Informasi Pembayaran Flip;
    else (Update Status Pesanan)
      :Pilih Pesanan yang Akan Diupdate;
      :Pilih Status Baru (PENDING / PROCESSING /\nSHIPPED / DELIVERED / CANCELED);
      :Update Status Pesanan di Database;
    endif
  endif
repeat while (Melakukan Kelola Data Lain?) is (Ya)

:Klik Tombol Logout Admin;
:Hapus Cookie JWT Token;
:Kembali ke Halaman Login;

:Selesai;
stop
@enduml
