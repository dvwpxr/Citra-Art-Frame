@startuml Flowchart_Customer_CitraFrame

title Flowchart Sistem Pelanggan (Customer) - CitraFrame

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #F9F9F9
  BorderColor #555555
  ArrowColor #333333
  DiamondBackgroundColor #FFFDE7
  DiamondBorderColor #C09553
}

start
:Mulai Akses Web CitraFrame;

if (Status Login Pelanggan?) then (Belum Login)
  repeat
    :Pilih Menu Login / Register;
    :Input Data Autentikasi (Email / Google);
    :Validasi Akun via Firebase Auth;
    if (Autentikasi Berhasil?) then (Gagal)
      :Tampilkan Pesan Error;
    else (Berhasil)
    endif
  repeat while (Autentikasi Berhasil?) is (Gagal)
  :Verifikasi Token & Buat Sesi Pelanggan;
else (Sudah Login)
endif

:Masuk ke Beranda CitraFrame;

if (Pilih Aktivitas Pelanggan) then (Katalog Bingkai)
  :Melihat Daftar Bingkai (Products);
  :Memilih & Melihat Detail Produk Bingkai;
else if (Katalog Art Prints)
  :Melihat Daftar Koleksi Seni (Art Prints);
  :Memilih & Melihat Detail Art Print;
else (Custom Frame Builder)
  :Membuka Custom Frame Builder;
  :Memilih Model & Ukuran Bingkai;
  :Mengatur Mat Board (Warna & Ketebalan);
  :Memilih Jenis Pelindung Kaca (Glass);
  if (Sumber Artwork?) then (Foto Sendiri)
    :Mengunggah Foto / Artwork Pribadi;
  else (Dari Katalog)
    :Memilih Artwork dari Katalog;
  endif
endif

if (Ingin Simulasi AR Sebelum Beli?) then (Ya)
  :Membuka Fitur Visualisasi AR;
  if (Pilih Mode AR) then (WebXR 3D)
    :Tampilkan Simulasi 3D di Ruang Nyata;
  else (Kamera Preview)
    :Tampilkan Preview via Kamera;
  endif
  :Tempatkan Bingkai & Capture Foto AR;
else (Tidak)
endif

:Klik Tombol "Tambah ke Keranjang";
:Simpan Item ke Database Keranjang;
:Buka Halaman Keranjang Belanja (Cart);

if (Kelola Item di Keranjang?) then (Ubah / Hapus)
  :Ubah Kuantitas atau Hapus Item;
  :Update Data Keranjang di Database;
else (Lanjut Checkout)
endif

:Klik Tombol "Checkout";
:Buka Halaman Checkout;

if (Alamat Pengiriman?) then (Tambah Alamat Baru)
  :Input Nama Penerima & No. Telepon;
  :Pilih Provinsi, Kabupaten, Kecamatan, Desa;
  :Ambil Data Wilayah dari API.co.id;
  :Input Alamat Lengkap & Kode Pos;
  if (Tandai Lokasi di Peta?) then (Ya)
    :Pin Koordinat di Peta Leaflet;
  else (Tidak)
  endif
  :Simpan Alamat Baru ke Buku Alamat;
else (Pilih Alamat Tersedia)
  :Pilih Alamat dari Buku Alamat;
endif

:Pilih Kurir / Ekspedisi Pengiriman;
:Hitung Ongkos Kirim via API.co.id;
:Tampilkan Subtotal, Ongkir, & Total Bayar;
:Klik Tombol "Buat Pesanan / Bayar";

if (Item Kategori Art Print?) then (Ya)
  :Cek Ketersediaan Stok Art Print;
  if (Stok Mencukupi?) then (Tidak)
    :Tampilkan Error Stok Tidak Cukup;
    end
  else (Ya / Cukup)
    :Kurangi Stok Art Print di Database;
  endif
else (Tidak / Frame Custom)
endif

:Simpan Data Pesanan ke Database (Status: PENDING);
:Kirim Request Pembuatan Tagihan ke Flip;
:Terima Payment URL dari Flip Gateway;
:Redirect Pelanggan ke Halaman Flip;
:Pelanggan Melakukan Pembayaran Sesuai Tagihan;

if (Verifikasi Pembayaran Flip?) then (Berhasil / Paid)
  :Terima Webhook Callback Pembayaran;
  :Update Status Pesanan Menjadi Diproses;
  :Tampilkan Bukti Pesanan & Invoice;
  :Simpan Riwayat Pesanan di Akun Pelanggan;
else (Gagal / Expired)
  :Status Pesanan Kadaluarsa / Canceled;
endif

:Selesai;
stop
@enduml
