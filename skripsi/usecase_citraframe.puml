@startuml CitraFrame Use Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam usecase {
  BackgroundColor #FFFDE7
  BorderColor #C09553
  ArrowColor #333333
  ActorBackgroundColor #FFF8F0
  ActorBorderColor #C09553
}

skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #CCCCCC
}

' ==========================================
' ACTORS
' ==========================================
actor "Pengunjung\n(Guest)" as Guest
actor "Pelanggan\n(Customer)" as Customer
actor "Admin" as Admin
actor "Firebase Auth" as Firebase <<system>>
actor "Flip Payment" as Flip <<system>>
actor "API.co.id" as APIcoid <<system>>

' ==========================================
' SISTEM CITRAFRAME
' ==========================================
rectangle "Sistem CitraFrame" {

  ' --- AUTH ---
  package "Autentikasi" {
    usecase "Mendaftar Akun\n(Email / Google)" as UC_Register
    usecase "Masuk Akun\n(Email / Google)" as UC_Login
    usecase "Keluar Akun" as UC_Logout
  }

  ' --- BROWSE / KATALOG ---
  package "Katalog & Produk" {
    usecase "Melihat Beranda\n& Slider Promo" as UC_Home
    usecase "Melihat Daftar\nBingkai (Produk)" as UC_BrowseProducts
    usecase "Melihat Detail\nProduk Bingkai" as UC_ProductDetail
    usecase "Melihat Daftar\nArt Prints" as UC_BrowsePrints
    usecase "Melihat Detail\nArt Print" as UC_PrintDetail
  }

  ' --- CUSTOM FRAME ---
  package "Custom Frame Builder" {
    usecase "Membuat Custom Frame\n(Builder)" as UC_CustomFrame
    usecase "Memilih Model\nBingkai" as UC_SelectFrame
    usecase "Mengatur Ukuran\n& Mat Board" as UC_ConfigureMat
    usecase "Mengatur Pelindung\nKaca" as UC_Glass
    usecase "Upload Foto\nArtwork" as UC_UploadArtwork
  }

  ' --- AR ---
  package "Visualisasi AR" {
    usecase "Membuka Mode\nVisualisasi AR" as UC_OpenAR
    usecase "Melihat Bingkai via\nWebXR (AR Nyata)" as UC_WebXR
    usecase "Melihat Bingkai via\nPreview Kamera" as UC_CameraAR
    usecase "Menempatkan\nBingkai di Dinding" as UC_PlaceFrame
    usecase "Mengambil Foto\nHasil AR" as UC_CaptureAR
  }

  ' --- CART ---
  package "Keranjang Belanja" {
    usecase "Menambah Produk\nke Keranjang" as UC_AddCart
    usecase "Melihat Keranjang\nBelanja" as UC_ViewCart
    usecase "Mengubah Jumlah\nItem Keranjang" as UC_UpdateCart
    usecase "Menghapus Item\ndari Keranjang" as UC_DeleteCart
  }

  ' --- CHECKOUT & PAYMENT ---
  package "Checkout & Pembayaran" {
    usecase "Melakukan Checkout" as UC_Checkout
    usecase "Memilih Alamat\nPengiriman" as UC_SelectAddress
    usecase "Memilih Ekspedisi\n& Cek Ongkir" as UC_SelectShipping
    usecase "Melakukan\nPembayaran (Flip)" as UC_Payment
    usecase "Menerima Invoice\n& Detail Pesanan" as UC_Invoice
  }

  ' --- AKUN ---
  package "Manajemen Akun" {
    usecase "Melihat Riwayat\nPesanan" as UC_OrderHistory
    usecase "Memfilter Status\nPesanan" as UC_FilterOrder
    usecase "Mengelola Buku\nAlamat" as UC_ManageAddress
    usecase "Menambah Alamat\nBaru" as UC_AddAddress
    usecase "Mengubah Alamat" as UC_EditAddress
    usecase "Menghapus Alamat" as UC_DeleteAddress
    usecase "Pin Lokasi di Peta\n(Leaflet)" as UC_PinMap
  }

  ' --- ADMIN ---
  package "Dashboard Admin" {
    usecase "Login Admin" as UC_AdminLogin
    usecase "Melihat Statistik\nDashboard" as UC_Dashboard
    usecase "Mengelola Produk\nBingkai" as UC_ManageProduct
    usecase "Tambah / Edit / Hapus\nProduk" as UC_CRUDProduct
    usecase "Set Produk Populer" as UC_SetPopular
    usecase "Mengelola Art Prints" as UC_ManagePrints
    usecase "Tambah / Edit / Hapus\nArt Print" as UC_CRUDArtPrint
    usecase "Mengelola Slider\nBeranda" as UC_ManageSlider
    usecase "Mengelola Pesanan" as UC_ManageOrder
    usecase "Update Status\nPesanan" as UC_UpdateOrderStatus
    usecase "Melihat Detail\nPesanan" as UC_OrderDetail
  }

}

' ==========================================
' RELASI PENGUNJUNG (GUEST)
' ==========================================
Guest --> UC_Home
Guest --> UC_BrowseProducts
Guest --> UC_ProductDetail
Guest --> UC_BrowsePrints
Guest --> UC_PrintDetail
Guest --> UC_Register
Guest --> UC_Login

' ==========================================
' RELASI PELANGGAN (CUSTOMER)
' ==========================================
Customer --> UC_Login
Customer --> UC_Logout
Customer --> UC_Home
Customer --> UC_BrowseProducts
Customer --> UC_ProductDetail
Customer --> UC_BrowsePrints
Customer --> UC_PrintDetail

Customer --> UC_CustomFrame
UC_CustomFrame ..> UC_SelectFrame : <<include>>
UC_CustomFrame ..> UC_ConfigureMat : <<include>>
UC_CustomFrame ..> UC_Glass : <<include>>
UC_CustomFrame ..> UC_UploadArtwork : <<extend>>

Customer --> UC_OpenAR
UC_OpenAR ..> UC_WebXR : <<extend>>
UC_OpenAR ..> UC_CameraAR : <<extend>>
UC_WebXR ..> UC_PlaceFrame : <<include>>
UC_WebXR ..> UC_CaptureAR : <<extend>>
UC_CameraAR ..> UC_CaptureAR : <<extend>>

Customer --> UC_AddCart
Customer --> UC_ViewCart
UC_ViewCart ..> UC_UpdateCart : <<extend>>
UC_ViewCart ..> UC_DeleteCart : <<extend>>

Customer --> UC_Checkout
UC_Checkout ..> UC_SelectAddress : <<include>>
UC_Checkout ..> UC_SelectShipping : <<include>>
UC_Checkout ..> UC_Payment : <<include>>
UC_Payment ..> UC_Invoice : <<include>>

Customer --> UC_OrderHistory
UC_OrderHistory ..> UC_FilterOrder : <<extend>>
UC_OrderHistory ..> UC_Invoice : <<extend>>

Customer --> UC_ManageAddress
UC_ManageAddress ..> UC_AddAddress : <<include>>
UC_ManageAddress ..> UC_EditAddress : <<extend>>
UC_ManageAddress ..> UC_DeleteAddress : <<extend>>
UC_AddAddress ..> UC_PinMap : <<extend>>

' ==========================================
' RELASI ADMIN
' ==========================================
Admin --> UC_AdminLogin
Admin --> UC_Dashboard
Admin --> UC_ManageProduct
UC_ManageProduct ..> UC_CRUDProduct : <<include>>
UC_ManageProduct ..> UC_SetPopular : <<extend>>
Admin --> UC_ManagePrints
UC_ManagePrints ..> UC_CRUDArtPrint : <<include>>
Admin --> UC_ManageSlider
Admin --> UC_ManageOrder
UC_ManageOrder ..> UC_UpdateOrderStatus : <<include>>
UC_ManageOrder ..> UC_OrderDetail : <<include>>

' ==========================================
' RELASI SISTEM EKSTERNAL
' ==========================================
UC_Login --> Firebase
UC_Register --> Firebase
UC_Payment --> Flip
UC_SelectShipping --> APIcoid
UC_AddAddress --> APIcoid
UC_EditAddress --> APIcoid

@enduml
